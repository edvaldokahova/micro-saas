# Copiar para .env.local (local) e para Vercel > Settings > Environment Variables
NEXT_PUBLIC_SITE_URL=https://entrega.bilonai.com
NEXT_PUBLIC_SUPABASE_URL=https://cypkcfiobmuchtnofkpw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Só no servidor. NUNCA com prefixo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Paddle. Sem estas variáveis o código usa a SANDBOX (token e preços públicos já no código).
# Em produção: NEXT_PUBLIC_PADDLE_ENV=production + token e IDs de preço da conta live.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_OFFICE=
# Secretos (só na Vercel):
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
RESEND_API_KEY=
